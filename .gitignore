# ── Secrets ───────────────────────────────────────────────
.env
broker_core/tokens/*.json
*.pem

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ── Tooling caches ────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# ── Runtime data (gitignored per CLAUDE.md Section 4) ──────
logs/*.log
db/*.db
paper_trading/accounts/*.json
paper_trading/trades/*.csv
paper_trading/backups/*.json

# Keep the data directories themselves tracked.
!**/.gitkeep

# ── Runtime pid files ─────────────────────────────────────
.pids/

# ── OS / editor ───────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# Secret backups — never commit
.env.bak*
.env.*.bak
*.bak
broker_client/earnings/data/*.csv
