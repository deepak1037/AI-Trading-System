# =============================================================
# AI-Trading-System — environment configuration template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Every key here maps 1:1 to config/settings.py (CLAUDE.md Section 15).
# Values shown are the defaults; override only what you need.
# =============================================================

# ── System ───────────────────────────────────────────────────
# ENV controls the run mode. See CLAUDE.md Section 2.
#   development | backtest | paper | live
ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log
# Verbose per-signal tracing when True.
DEBUG_SIGNALS=False
# Master safety switch — no real orders while True.
DRY_RUN=True
# Must be True (with ENV=live and DRY_RUN=False) to place live orders.
LIVE_TRADING_ENABLED=False

# ── Broker ───────────────────────────────────────────────────
# alpaca | schwab | ibkr
BROKER=alpaca
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
SCHWAB_ACCOUNT_NUMBER=
SCHWAB_TOKEN_FILE=broker_core/tokens/schwab_token.json
ALPACA_TOKEN_FILE=broker_core/tokens/alpaca_token.json
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=True
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Signal thresholds ────────────────────────────────────────
# Macro surprise in standard deviations (sigma).
MACRO_SURPRISE_CRITICAL=2.0
MACRO_SURPRISE_MODERATE=0.5
# 10yr Treasury yield delta in absolute points (0.05 = 5 bps).
YIELD_DELTA_THRESHOLD=0.05
# FinBERT sentiment score threshold.
SENTIMENT_THRESHOLD=0.3
# NQ futures move that flips premarket bearish (-0.008 = -0.8%).
PREMARKET_FUTURES_THRESHOLD=-0.008
# Confidence (0-100) gates for alert severity.
CONFIDENCE_CRITICAL=80
CONFIDENCE_HIGH=65
# Composite score jump (pts) that triggers a High alert.
SCORE_DELTA_ALERT=15

# ── Signal fusion weights (must sum to 100) ──────────────────
WEIGHT_MACRO=30
WEIGHT_YIELD=25
WEIGHT_SENTIMENT=20
WEIGHT_PREMARKET=15
WEIGHT_TECHNICAL=10
# Additive bonus (pts) when short/mid/long timeframes agree.
WEIGHT_TF_ALIGNMENT_BONUS=10

# ── Strategies ───────────────────────────────────────────────
# JSON list of enabled strategy keys (STRATEGY_REGISTRY).
ENABLED_STRATEGIES=["equity_long_short"]
# JSON map: regime -> strategies to close on transition into it.
REGIME_CLOSE_TRIGGERS={"strong_short": ["equity_long_short", "momentum_breakout"]}

# ── Risk ─────────────────────────────────────────────────────
# Max fraction of portfolio per single position (0.05 = 5%).
MAX_POSITION_PCT=0.05
# Max fraction of portfolio at risk across all positions.
MAX_PORTFOLIO_RISK_PCT=0.20
# Halt trading if down this fraction on the day (0.02 = 2%).
DAILY_LOSS_LIMIT_PCT=0.02
# Fraction of full Kelly criterion to size with.
KELLY_FRACTION=0.25
# ATR multipliers for stop-loss / take-profit.
STOP_LOSS_ATR_MULTIPLIER=2.0
TAKE_PROFIT_ATR_MULTIPLIER=3.0

# ── Position watcher ─────────────────────────────────────────
POSITION_SCAN_INTERVAL_SECONDS=60

# ── Watcher schedule ─────────────────────────────────────────
# Overnight/premarket/open/session/power-hour in MINUTES; macro in SECONDS.
WATCHER_OVERNIGHT_INTERVAL=15
WATCHER_PREMARKET_INTERVAL=5
WATCHER_MACRO_INTERVAL=30
WATCHER_OPEN_INTERVAL=1
WATCHER_SESSION_INTERVAL=5
WATCHER_POWER_HOUR_INTERVAL=1

# ── Paper trading ────────────────────────────────────────────
# JSON list of paper account ids.
PAPER_ACCOUNTS=["paper_main"]
# next_open | vwap | worst_case
PAPER_FILL_METHOD=next_open
# Equity slippage fraction (0.001 = 0.1%).
PAPER_SLIPPAGE_PCT=0.001
# Equity commission per share (Schwab = 0).
PAPER_COMMISSION_PER_SHARE=0.0
# Options slippage as fraction of bid-ask spread (0.5 = 50%).
PAPER_OPTIONS_SLIPPAGE=0.5
# Options commission per contract.
PAPER_OPTIONS_COMMISSION=0.65
# Days of daily JSON backups to retain.
PAPER_BACKUP_DAYS=30
PAPER_ACCOUNTS_DIR=paper_trading/accounts
PAPER_TRADES_DIR=paper_trading/trades
PAPER_BACKUPS_DIR=paper_trading/backups

# ── Dashboard ────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=60
DASHBOARD_PORT=8501
DASHBOARD_BENCHMARK_TICKER=SPY

# ── Database ─────────────────────────────────────────────────
DB_PATH=db/trading.db

# ── APIs ─────────────────────────────────────────────────────
API_MAX_RETRIES=3
API_BACKOFF_SECONDS=2.0
API_CIRCUIT_BREAKER_FAILURES=5
API_CIRCUIT_BREAKER_TIMEOUT=300
POLYGON_API_KEY=
FRED_API_KEY=
NEWS_API_KEY=
# ── Stage 3 fundamentals source priority: Moomoo > FMP(paid) > yfinance ──
# Moomoo OpenD (local gateway) — PRIMARY source: free, accurate non-GAAP
# quarterly EPS. Requires the OpenD app running locally.
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
# Financial Modeling Prep — used only if Moomoo is down AND a PAID key is present
# (free tier returns HTTP 402 for income statements). Uses the /stable API.
FMP_API_KEY=

# ── LLM (Claude) — options ROI analysis ──────────────────────
# Powers `make analyze` and the dashboard Options Analyzer page. If blank, the
# quantitative ROI still renders but the Claude assessment is skipped.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60.0

# ── Options ROI ──────────────────────────────────────────────
OPTIONS_CONTRACT_MULTIPLIER=100
# reg_t = naked-put initial margin | cash_secured = full (strike-premium) cash
OPTIONS_MARGIN_BASIS=reg_t
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
SLACK_WEBHOOK_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_TO_EMAIL=
# SEC EDGAR User-Agent header: "Name email@example.com" (required by edgartools).
EDGAR_IDENTITY=AI Trading System trading@example.com
# API rate limits (calls per second per provider).
YFINANCE_RATE_LIMIT=1.0
ALPACA_RATE_LIMIT=5.0
FRED_RATE_LIMIT=2.0

# ── Alerts ───────────────────────────────────────────────────
# Suppress repeat alerts of the same type within this window.
ALERT_DEDUP_MINUTES=30
ALERT_DIGEST_INTERVAL_MINUTES=60

# ── Discord webhooks ─────────────────────────────────────────
# Create a webhook per channel: Server Settings → Integrations → Webhooks.
DISCORD_ENABLED=True
DISCORD_WEBHOOK_ALERTS=         # #alerts        — critical (red)
DISCORD_WEBHOOK_SIGNALS=        # #signals       — high (yellow)
DISCORD_WEBHOOK_OPPORTUNITIES=  # #opportunities — green
DISCORD_WEBHOOK_BRIEFING=       # #daily-briefing — blue

# ── Scanner ──────────────────────────────────────────────────
SCANNER_UNIVERSE_MIN_PRICE=5.0
SCANNER_UNIVERSE_MIN_VOLUME=500000
SCANNER_UNIVERSE_MIN_MKTCAP=200000000
# Minimum composite score (0-100) to enter the watchlist.
SCANNER_WATCHLIST_THRESHOLD=65
SCANNER_FULL_RUN_DAY=sunday
SCANNER_DAILY_RUN_HOUR=6
# Composite scoring weights for the multi-bagger scanner (must sum to 100).
# Distinct from the signal-fusion WEIGHT_* above (live trader subsystem).
SCANNER_WEIGHT_FUNDAMENTAL=35
SCANNER_WEIGHT_INSTITUTIONAL=25
SCANNER_WEIGHT_TECHNICAL=30
SCANNER_WEIGHT_SQUEEZE=5
SCANNER_WEIGHT_TF_ALIGNMENT=5
